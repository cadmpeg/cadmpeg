#!/bin/sh
# Mirrors the CI gate in .github/workflows/ci.yml (fmt, clippy, tests).
# Skip with: git commit --no-verify
set -e

# Specification references in the open-items documents name a section and a
# paragraph start rather than a line number, so they stay valid as the
# specification grows. Validate them whenever either side is staged.
if git diff --cached --name-only | grep -qE '^docs/formats/.*\.md$'; then
  echo "pre-commit: scripts/check-doc-anchors.py"
  python3 scripts/check-doc-anchors.py
fi

# Dialect ids are pinned forever, so a bad edit to the registry must not reach
# a commit. Run the checker's own synthesized-violation suite first: it is the
# only thing that proves the rules still fire.
if git diff --cached --name-only | grep -qE '^docs/dialects\.toml$|^scripts/(check-dialects\.py|test_check_dialects\.py)$'; then
  echo "pre-commit: scripts/check-dialects.py"
  python3 scripts/check-dialects.py --self-test
  python3 scripts/check-dialects.py
fi

# The capability registry cross-references the identity registry, the fixture
# tree, the golden snapshots, and the encoders' write-target catalogs. Any of
# those five can move it, so run it whenever one is staged.
if git diff --cached --name-only \
    | grep -qE '^docs/(dialects?(-support)?|evaluations)\.toml$|^scripts/(check-dialect-support\.py|test_check_dialect_support\.py)$|^crates/cadmpeg-codec-[^/]+/(src/.*\.rs|tests/(golden|fixtures)/)|^corpus/freecad_fcstd/fixtures/'; then
  echo "pre-commit: scripts/check-dialect-support.py"
  python3 scripts/check-dialect-support.py --self-test
  python3 scripts/check-dialect-support.py
fi

# Public API ledger rows and snapshots move together. Crate source changes also
# run the structural check so this gate remains attached to the API inputs.
if git diff --cached --name-only \
    | grep -qE '^docs/public-api-ledger\.toml$|^docs/api-baseline/.*\.txt$|^crates/[^/]+/src/|^scripts/(check-public-api-ledger\.py|test_check_public_api_ledger\.py)$'; then
  echo "pre-commit: scripts/check-public-api-ledger.py"
  python3 scripts/check-public-api-ledger.py --self-test
  python3 scripts/check-public-api-ledger.py
fi

# Every published capability table is rendered from the two registries. A
# registry edit without a re-render, or a hand edit inside a generated region,
# must not reach a commit. Run it whenever a registry, the renderer, or a file
# that owns a generated region is staged.
if git diff --cached --name-only \
    | grep -qE '^docs/dialects?(-support)?\.toml$|^docs/format-support\.md$|^README\.md$|^scripts/(render-format-support\.py|test_render_format_support\.py)$|^crates/cadmpeg-codec-[^/]+/(README\.md|src/lib\.rs)$'; then
  echo "pre-commit: scripts/render-format-support.py --check"
  python3 scripts/render-format-support.py --self-test
  python3 scripts/render-format-support.py --check
fi

# Only run the Rust gate when the commit stages files that can change its
# outcome: Rust sources, the manifests or lockfile, the Cargo config (aliases
# and build flags), or the toolchain pin. A docs-, CI-, or config-only commit
# cannot affect fmt/clippy/tests, so compiling the whole workspace for it is
# pure latency. `--no-verify` still forces a skip.
if ! git diff --cached --name-only \
    | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain\.toml$|(^|/)\.cargo/'; then
  echo "pre-commit: no Rust/Cargo files staged; skipping the Rust gate"
  exit 0
fi

echo "pre-commit: scripts/convergence-ratchet.py"
python3 scripts/convergence-ratchet.py

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

# Scope clippy and tests to the staged crates plus their transitive workspace
# dependents. A leaf-codec commit must not fail on pre-existing lint debt in
# crates it did not touch, and it must not pay full-workspace latency; a
# shared-crate commit (cadmpeg-ir, cadmpeg-core) still gates every
# dependent codec through the reverse-dependency closure. Manifest, lockfile,
# Cargo-config, and toolchain changes fall back to the full workspace, as does
# any staged Rust file that no workspace crate owns.
if git diff --cached --name-only \
    | grep -qE '(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain\.toml$|(^|/)\.cargo/'; then
  scope="WORKSPACE"
else
  scope=$(python3 scripts/staged-crates.py)
fi

if [ "$scope" = "WORKSPACE" ]; then
  echo "pre-commit: cargo clippy --workspace --all-targets"
  cargo clippy --workspace --all-targets
  echo "pre-commit: cargo test-fast"
  cargo test-fast
elif [ -n "$scope" ]; then
  pkg_flags=$(printf ' -p %s' $scope)
  # `--all-targets` rather than `--lib --bins --tests`, because `--lib` is an
  # error when no selected package has a library target. A commit that stages
  # only `crates/cadmpeg`, which is a binary-only package, could not pass the
  # gate at all. Clippy uses the same flag so test targets cannot hide style debt.
  echo "pre-commit: cargo clippy$pkg_flags --all-targets"
  cargo clippy $pkg_flags --all-targets
  echo "pre-commit: cargo test$pkg_flags --all-targets"
  cargo test $pkg_flags --all-targets
else
  echo "pre-commit: staged Rust/Cargo files belong to no workspace crate; skipping"
fi
