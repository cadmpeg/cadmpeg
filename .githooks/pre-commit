#!/bin/sh
# Fast pre-filter for the CI gate in .github/workflows/ci.yml. It runs the
# checks that finish in about a second, rustfmt on the crates that own the
# staged files, and clippy on those crates plus their workspace dependents.
# CI runs the tests, the whole-tree policy scans, and the dialect identity
# registry check. Skip with: git commit --no-verify
set -e

staged=$(git diff --cached --name-only)
staged_matches() {
  printf '%s\n' "$staged" | grep -qE "$1"
}

# Specification references in the open-items documents name a section and a
# paragraph start rather than a line number, so they stay valid as the
# specification grows. Validate them whenever either side is staged.
if staged_matches '^docs/formats/.*\.md$'; then
  echo "pre-commit: scripts/check-doc-anchors.py"
  python3 scripts/check-doc-anchors.py
fi

# Run checker tests only when their implementation, dependencies, or tests change.
if staged_matches '^\.githooks/pre-commit$|^scripts/test_pre_commit\.py$'; then
  python3 -m unittest -q scripts/test_pre_commit.py
fi
if staged_matches '^scripts/(check-dialect-support|dialect_support_data|test_check_dialect_support)\.py$'; then
  python3 -m unittest discover -q -s scripts -p test_check_dialect_support.py
fi
if staged_matches '^scripts/(render-format-support|dialect_support_data|test_render_format_support)\.py$'; then
  python3 -m unittest discover -q -s scripts -p test_render_format_support.py
fi
if staged_matches '^scripts/(check-resource-caps|test_check_resource_caps)\.py$'; then
  python3 -m unittest -q scripts/test_check_resource_caps.py
fi

# The capability registry cross-references the identity registry, fixture tree,
# and golden snapshots. Run its docs-only checks whenever an input is staged.
if staged_matches '^crates/cadmpeg-registry/docs/dialects?(-support)?\.toml$|^docs/evaluations\.toml$|^scripts/(check-dialect-support\.py|dialect_support_data\.py|test_check_dialect_support\.py)$|^crates/cadmpeg-codec-[^/]+/(src/.*\.rs|tests/(golden|fixtures)/)|^corpus/freecad_fcstd/fixtures/'; then
  echo "pre-commit: scripts/check-dialect-support.py"
  python3 scripts/check-dialect-support.py
fi

# Every published capability table is rendered from the two registries. A
# registry edit without a re-render, or a hand edit inside a generated region,
# must not reach a commit. Run it whenever a registry, the renderer, or a file
# that owns a generated region is staged.
if staged_matches '^crates/cadmpeg-registry/docs/dialects?(-support)?\.toml$|^docs/evaluations\.toml$|^docs/format-support\.md$|^README\.md$|^scripts/(dialect_support_data\.py|render-format-support\.py|test_render_format_support\.py)$|^crates/cadmpeg-codec-[^/]+/(README\.md|src/lib\.rs)$'; then
  echo "pre-commit: scripts/render-format-support.py --check"
  python3 scripts/render-format-support.py --check
fi

# Only run the Rust gate when the commit stages files that can change its
# outcome: Rust sources, the manifests or lockfile, the Cargo config (aliases
# and build flags), or the toolchain pin.
if ! staged_matches '\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain\.toml$|(^|/)\.cargo/'; then
  echo "pre-commit: no Rust/Cargo files staged; skipping the Rust gate"
  exit 0
fi

# `cargo fmt -p` checks the crates that own a staged file. It supplies the
# edition and follows the module tree, so files a crate pulls in with
# `include!`, such as the generated `registry_ids.rs`, stay unchecked as under
# `cargo fmt --all`. Clippy checks the staged crates plus their transitive
# workspace dependents, so a shared-crate commit (cadmpeg-ir, cadmpeg-core)
# still lints every dependent codec. Manifest, lockfile, Cargo-config, and
# toolchain changes fall back to the full workspace, as does any staged Rust
# file that no workspace crate owns.
if staged_matches '(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain\.toml$|(^|/)\.cargo/'; then
  owners="WORKSPACE"
  scope="WORKSPACE"
else
  owners=$(python3 scripts/staged-crates.py --owners)
  scope=$(python3 scripts/staged-crates.py)
fi

if [ "$owners" = "WORKSPACE" ]; then
  echo "pre-commit: cargo fmt --all --check"
  cargo fmt --all --check
elif [ -n "$owners" ]; then
  fmt_flags=$(printf ' -p %s' $owners)
  echo "pre-commit: cargo fmt$fmt_flags --check"
  cargo fmt $fmt_flags --check
fi

if [ "$scope" = "WORKSPACE" ]; then
  echo "pre-commit: cargo clippy --workspace --all-targets"
  cargo clippy --workspace --all-targets
elif [ -n "$scope" ]; then
  pkg_flags=$(printf ' -p %s' $scope)
  # `--all-targets` keeps test targets under the lint, and it type-checks a
  # binary-only package such as `crates/cadmpeg`, where `--lib` fails.
  echo "pre-commit: cargo clippy$pkg_flags --all-targets"
  cargo clippy $pkg_flags --all-targets
else
  echo "pre-commit: staged Rust/Cargo files belong to no workspace crate; skipping"
fi
