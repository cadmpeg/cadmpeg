def Scope "Looks"
{
    def Material "Box_face_1_material"
    {
        token outputs:surface.connect = </Looks/Box_face_1_material/PreviewSurface.outputs:surface>
        token outputs:mtlx:surface.connect = </Looks/Box_face_1_material/MaterialX.outputs:out>
        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.2, 0.4, 0.6)
            token outputs:surface
        }
        def Shader "MaterialX"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.4, 0.6)
            token outputs:out
        }
    }
    def Material "Box_Edge1_appearance"
    {
