            color3f inputs:diffuseColor = (0.7019608, 0.2, 0.101960786)
            token outputs:surface
        }
        def Shader "MaterialX"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.7019608, 0.2, 0.101960786)
            token outputs:out
